# copy to .env — docker compose reads it automatically. .env is gitignored.

DOMAIN=forms.internal.example.com
ACME_EMAIL=ops@example.com

# --- Database -------------------------------------------------------------
# Default (leave FFF_DATABASE_URL unset): embedded SQLite at FFF_DB / the
# --db flag, stored in the /data volume. Right for a single team — see
# docs/deployment/SCALE.md.
FFF_DB=/data/formfromfile.db
#
# To use Postgres instead, set FFF_DATABASE_URL to a postgres:// URL. The app
# creates its own tables on first boot. Use sslmode=require for a remote host.
#   FFF_DATABASE_URL=postgres://fff:CHANGE_ME@db:5432/fff?sslmode=require
# Or point at a file holding the URL (Docker/k8s secrets), which keeps the
# password out of the process environment:
#   FFF_DATABASE_URL_FILE=/run/secrets/fff_database_url
FFF_DATABASE_URL=

# --- Auth / registration -------------------------------------------------
# set false once your first (admin) account exists
FFF_ALLOW_REGISTER=true

# --- Webhooks ----------------------------------------------------------------
# webhooks to LAN targets (http, private IPs) — internal deployments only
FFF_WEBHOOK_ALLOW_PRIVATE=false

# --- Public-form spam control --------------------------------------------
# free, from https://dash.cloudflare.com -> Turnstile
# (leave blank to disable; no CAPTCHA shown, per-IP rate limit still applies)
FFF_TURNSTILE_SITE_KEY=
FFF_TURNSTILE_SECRET=

# --- AI assist (BETA, off by default) -----------------------------------
# needs BOTH of these set
FFF_ANTHROPIC_API_KEY=
FFF_AI_BETA=

# --- Google sign-in via Firebase ---------------------------------------
# leave blank to disable (password-only, as today). See docs/guides/AUTH.md.
# All four are the public Firebase Web SDK config, not secrets.
FFF_FIREBASE_PROJECT_ID=
FFF_FIREBASE_API_KEY=
FFF_FIREBASE_AUTH_DOMAIN=
FFF_FIREBASE_APP_ID=

# --- Observability -----------------------------------------------------
# set a token to expose GET /metrics (Prometheus) behind a bearer header
FFF_METRICS_TOKEN=
# FFF_LOG_FORMAT=json for structured logs; FFF_LOG_LEVEL=debug|info|warn|error
FFF_LOG_FORMAT=
